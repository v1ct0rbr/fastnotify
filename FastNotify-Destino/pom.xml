<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.victorqueiroga.fastnotify</groupId>
    <artifactId>fastnotify-destino</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>FastNotify Destino</name>
    <description>Aplicativo de exibicao de notificacoes em rede - FastNotify (JavaFX)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <mainClass>com.victorqueiroga.fastnotify.destino.Main</mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>jsvg</artifactId>
            <version>2.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>fastnotify-destino</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-config-next-to-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/config"/>
                                <copy todir="${project.build.directory}/config" overwrite="false">
                                    <fileset dir="${project.basedir}/src/main/resources/config"/>
                                </copy>
                                <mkdir dir="${project.build.directory}/img"/>
                                <copy todir="${project.build.directory}/img" overwrite="true">
                                    <fileset dir="${project.basedir}/src/main/resources/img"/>
                                </copy>
                                <mkdir dir="${project.build.directory}/sounds"/>
                                <copy todir="${project.build.directory}/sounds" overwrite="true">
                                    <fileset dir="${project.basedir}/src/main/resources/sounds"/>
                                </copy>
                                <copy todir="${project.build.directory}" overwrite="true">
                                    <fileset dir="${project.basedir}/src/main/resources"
                                             includes="instalar-inicializacao-destino.bat,instalar-inicializacao-destino.ps1,remover-inicializacao-destino.bat,remover-inicializacao-destino.ps1,liberar-porta-destino.bat,liberar-porta-destino.ps1,remover-porta-destino.bat"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-deps</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.5.2</version>
                <executions>
                    <execution>
                        <id>l4j-destino</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>gui</headerType>
                            <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                            <outfile>${project.build.directory}/FastNotify-Destino.exe</outfile>
                            <errTitle>FastNotify Destino</errTitle>
                            <icon>${project.basedir}/src/main/resources/img/mensagem-recebida.ico</icon>
                            <classPath>
                                <mainClass>${mainClass}</mainClass>
                                <addDependencies>true</addDependencies>
                                <jarLocation>lib/</jarLocation>
                            </classPath>
                            <jre>
                                <minVersion>17</minVersion>
                                <initialHeapSize>128</initialHeapSize>
                                <maxHeapSize>512</maxHeapSize>
                            </jre>
                            <chdir>.</chdir>
                            <versionInfo>
                                <fileVersion>1.0.0.0</fileVersion>
                                <txtFileVersion>1.0.0</txtFileVersion>
                                <fileDescription>FastNotify Destino</fileDescription>
                                <copyright>FastNotify</copyright>
                                <productVersion>1.0.0.0</productVersion>
                                <productName>FastNotify Destino</productName>
                                <internalName>fastnotify-destino</internalName>
                                <originalFilename>FastNotify-Destino.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
